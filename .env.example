# ─── Required ───
BOT_TOKEN=your_discord_bot_token_here
OWNER_ID=your_discord_user_id_here

# ─── Optional ───

# Guild ID for instant slash command registration (recommended for development)
# If not set, commands are registered globally (takes ~1 hour to propagate)
GUILD_ID=your_server_id_here

# Default log channel ID (fallback if no guild-specific log channel is configured) also its bugged so i suggest not using it leave it blank 
LOG_CHANNEL_ID=your_log_channel_id_here


# Web Dashboard password (set this to access the dashboard at your Railway URL or geniuely use any hoster you want i js prefer railway cuz its free and easy to setup)
# If not set, defaults to "admin"
DASHBOARD_PASSWORD=your_dashboard_password_here

---

# lets say you chose to use railway this env file would be useless in you click on the serivce then click on variables add the following variable

BOT_TOKEN=your_discord_bot_token_here

DASHBOARD_PASSWORD=whatever_password_you_want_here

GUILD_ID=your_server_ID

#this one is bugged it acts as a fallback but i suggest you leave it blank and configure the logs via dashboard which is far better 
LOG_CHANNEL_ID=this_is_useless_but_if_you_want_to_make_all_logs_in_one_channel put the channel ID in here 


OWNER_ID=your_discord_user_id_here so you only access the bot and dashboard

---
# to get the domain for ur dashboard you're gonna click on the service then click on settings scroll down until you see "networking" click create domain then put the domain in thee value for it
RAILWAY_PUBLIC_DOMAIN=your_railway_public_domain_here 
