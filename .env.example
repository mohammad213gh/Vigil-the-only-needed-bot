# ──────────────────────────────────────────────
#  Environment Variables
#  Copy this to .env, fill in your stuff
# ──────────────────────────────────────────────

# ═══ YOU NEED THESE ═══

# Get this from the Discord Developer Portal
BOT_TOKEN=your_discord_bot_token_here

# Your Discord user ID so only you can use owner commands + dashboard
OWNER_ID=your_discord_user_id_here

# Password to get into the web dashboard
DASHBOARD_PASSWORD=choose_a_strong_password

# ═══ STRONGLY RECOMMENDED ═══

# Your server ID for instant slash commands (otherwise they take ~1 hour to show up)
GUILD_ID=your_test_server_id

# The public URL of your dashboard (used in /dashboard command)
# On Railway you generate this in Settings → Networking
# Railway also auto-sets RAILWAY_PUBLIC_DOMAIN — the bot will use that if DASHBOARD_URL isn't set
DASHBOARD_URL=https://your-bot-dashboard.com

# ═══ DATA PERSISTENCE (SO IT DOESN'T RESET ON EVERY REDEPLOY) ═══

# Where all your bot data lives (warns, configs, stats, everything)
# If you don't set this, everything resets when you redeploy.
#
# For Railway:
#   1. Go to Volumes tab → Add Volume
#   2. Mount it at /data
#   3. Set DATA_DIR=/data
#
# For Docker:
#   docker run -v /host/path:/data -e DATA_DIR=/data ...
#
# Default is ./data/ (inside the project folder, gets wiped on redeploy)
DATA_DIR=/path/that/survives/redeploys

# ═══ NICE TO HAVE ═══

# Dashboard port (defaults to 3000)
# PORT=3000

# Dashboard session expires after this many hours of inactivity (default 24)
# DASHBOARD_SESSION_HOURS=24

# ...and dies for good after this many days no matter what (default 7)
# DASHBOARD_SESSION_MAX_DAYS=7

# Console log verbosity: debug | info | warn | error (default info)
# LOG_LEVEL=info

# On Railway this is auto-set and used as the dashboard URL — no need to touch it.
# RAILWAY_PUBLIC_DOMAIN=

# Shows up in the dashboard footer
# BRAND_NAME=Vigil

# Where uploaded background images go (defaults to ./uploads)
# UPLOADS_DIR=./uploads

# ═══ OLD STUFF YOU DON'T NEED ANYMORE ═══
#
# The bot uses SQLite now (bot.db in DATA_DIR) so these are retired:
#   - CONFIG_PATH
#   - REMINDERS_PATH
#   - LOG_CHANNEL_ID
