# ──────────────────────────────────────────────
#  Discord Bot — Environment Variables
#  Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# ══════════════════════════════════════════════
#  REQUIRED
# ══════════════════════════════════════════════

# Your Discord bot token (from Discord Developer Portal)
BOT_TOKEN=your_discord_bot_token_here

# Your Discord user ID (only you can use owner commands + dashboard)
OWNER_ID=your_discord_user_id_here

# Password for the web dashboard login
DASHBOARD_PASSWORD=choose_a_strong_password

# ══════════════════════════════════════════════
#  RECOMMENDED
# ══════════════════════════════════════════════

# Server ID for INSTANT slash command registration
# Without this, commands are registered globally (takes ~1 hour)
GUILD_ID=your_test_server_id

# Public domain for your dashboard (shown in /dashboard command)
# On Railway: Settings → Networking → Generate Domain
DASHBOARD_URL=https://your-bot-dashboard.com

# ══════════════════════════════════════════════
#  DATA PERSISTENCE (IMPORTANT!)
# ══════════════════════════════════════════════

# Directory where all bot data is stored (warnings, configs, stats, etc.)
# Without this, data resets on every redeploy!
#
# For Railway:
#   1. Go to your service → Volumes → Add Volume
#   2. Set mount path to: /data
#   3. Then set: DATA_DIR=/data
#
# For Docker:
#   docker run -v /host/path:/data -e DATA_DIR=/data ...
#
# Default: ./data/ (inside project — resets on redeploy)
DATA_DIR=/path/that/survives/redeploys

# ══════════════════════════════════════════════
#  OPTIONAL
# ══════════════════════════════════════════════

# Dashboard port (default: 3000)
# PORT=3000

# Brand name shown in the dashboard footer
# BRAND_NAME=My Bot

# Directory for dashboard file uploads (default: ./uploads)
# UPLOADS_DIR=./uploads

# ══════════════════════════════════════════════
#  LEGACY (for reference — no longer needed)
# ══════════════════════════════════════════════
#
# The bot now uses SQLite (bot.db) in DATA_DIR for ALL storage.
# These old env vars are no longer used:
#   - CONFIG_PATH
#   - REMINDERS_PATH
#   - LOG_CHANNEL_ID
